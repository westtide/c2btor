*.cpp text diff=cpp
*.c text diff=cpp
*.h text diff=cpp
*.y text
*.tex text
*.shtml text
*.html text
*.css text
*.inc text
*.desc text
*.md text
Makefile text
# Keep pinned upstream schemas byte-identical, including upstream trailing spaces.
scripts/tests/schema/** whitespace=-blank-at-eol
test/tools/patches/cpachecker-condition-location.patch whitespace=-blank-at-eol

# Product entry point and retained Perl build/regression tools.
c2btor-verify text eol=lf
*.pl text eol=lf

# Keep executable scripts and release documentation portable from Windows.
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
.gitignore text eol=lf
*.png binary

# Preserve imported third-party license notices verbatim.
LICENSES/** whitespace=-blank-at-eol
